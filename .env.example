# Clave de la API de Groq (https://console.groq.com/keys)
GROQ_API_KEY=gsk_...

# Proyecto de Appwrite (https://cloud.appwrite.io)
# El subdominio depende de la región del proyecto: sfo, fra, nyc…
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sfo.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=...
NEXT_PUBLIC_APPWRITE_DATABASE_ID=...
NEXT_PUBLIC_APPWRITE_TABLE_DIAGNOSTICOS=diagnosticos

# API key de servidor (Appwrite → Overview → Integrations → API Keys)
# Scopes necesarios: tables.read, tables.write, rows.read, rows.write
# (databases.write también, si vas a usar npm run setup:appwrite)
APPWRITE_API_KEY=...

# Código que hay que introducir para pasar a rol "docente" (registro o perfil).
# Sin esto configurado, /api/rol devuelve 501 y nadie puede ser docente.
CODIGO_DOCENTE=...
